# Salin ke .env lalu isi nilainya. Jangan commit .env.

# PostgreSQL. Untuk produksi pakai container db:5432.
DATABASE_URI=postgres://user:password@127.0.0.1:5432/rinjanmedia

# String acak 32+ karakter. Buat dengan: openssl rand -base64 32
PAYLOAD_SECRET=

# URL publik situs, dipakai untuk metadata & CORS Payload.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Notifikasi lead (Fase 4)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
